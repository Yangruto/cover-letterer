{
  "name": "cover-letterer",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
